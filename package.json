{
  "name": "rentbond",
  "version": "0.0.0",
  "private": true,
  "description": "RentBond programmable rental-deposit settlement workspace",
  "engines": { "node": "24.14.0" },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check-scaffold.mjs",
    "ts04": "node scripts/ts04-clone-verify.mjs",
    "test:runner": "node tests/runner.mjs",
    "infra:up": "node scripts/not-implemented.mjs infra:up RB-02",
    "db:migrate": "npm run db:migrate --prefix apps/web",
    "chain:local": "node scripts/not-implemented.mjs chain:local RB-03",
    "contracts:deploy:local": "node scripts/not-implemented.mjs contracts:deploy:local RB-03",
    "contracts:preflight:testnet": "node scripts/deploy-contracts-testnet.mjs --check",
    "contracts:deploy:testnet": "node scripts/deploy-contracts-testnet.mjs",
    "contracts:export:abi": "node scripts/export-contract-abis.mjs",
    "fixtures:seed": "npm run backend:seed --prefix apps/web",
    "backend:init": "npm run backend:init --prefix apps/web",
    "backend:worker": "npm run backend:worker --prefix apps/web",
    "test:backend": "npm run test:backend --prefix apps/web",
    "dev": "node scripts/not-implemented.mjs dev RB-02",
    "worker:dev": "node scripts/not-implemented.mjs worker:dev RB-12",
    "worker:health": "node scripts/worker-health.mjs",
    "test:contracts": "npx --yes @foundry-rs/forge@1.7.1 test --root contracts -vv",
    "build:contracts": "npx --yes @foundry-rs/forge@1.7.1 build --root contracts",
    "check:contract-sizes": "npx --yes @foundry-rs/forge@1.7.1 build --root contracts --sizes --skip test --skip script",
    "test:integration": "node tests/runner.mjs integration",
    "test:e2e": "node tests/runner.mjs e2e",
    "test:all": "node tests/runner.mjs all",
    "build": "node scripts/not-implemented.mjs build RB-02"
  }
}
