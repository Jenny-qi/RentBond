{
  "name": "rentbond",
  "version": "0.0.0",
  "private": true,
  "description": "RentBond member C frontend and explicit fixture preview; live integration pending",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check-scaffold.mjs && pnpm --filter @rentbond/web typecheck && pnpm --filter @rentbond/web test",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "test:web": "pnpm --filter @rentbond/web test",
    "test:web:e2e": "pnpm --filter @rentbond/web test:e2e",
    "infra:up": "node scripts/not-implemented.mjs infra:up RB-02",
    "db:migrate": "node scripts/not-implemented.mjs db:migrate RB-08",
    "chain:local": "node scripts/not-implemented.mjs chain:local RB-03",
    "contracts:deploy:local": "node scripts/not-implemented.mjs contracts:deploy:local RB-03",
    "contracts:deploy:testnet": "node scripts/not-implemented.mjs contracts:deploy:testnet RB-03",
    "fixtures:seed": "node scripts/not-implemented.mjs fixtures:seed RB-08",
    "dev": "pnpm --filter @rentbond/web dev",
    "worker:dev": "node scripts/not-implemented.mjs worker:dev RB-12",
    "test:contracts": "node scripts/not-implemented.mjs test:contracts RB-04",
    "test:integration": "node scripts/not-implemented.mjs test:integration RB-13",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e RB-13",
    "build": "pnpm --filter @rentbond/web build"
  }
}
