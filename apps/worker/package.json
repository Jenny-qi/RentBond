{
  "name": "@rentbond/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Independent Node.js event sync and deadline worker for RentBond",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../web/.env.local src/main.ts",
    "start": "node --env-file-if-exists=../web/.env.local src/main.ts",
    "build": "node --check src/main.ts",
    "test": "npm run test:worker --prefix ../web"
  },
  "dependencies": {
    "@rentbond/shared": "workspace:*",
    "jspdf": "^4.2.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "22.10.0"
  }
}
