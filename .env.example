# Member D API: place configuration in apps/web/.env.local.
# npm run backend:init creates a local-only config with a random SESSION_SECRET.

# =============================================================================
# App / Web (C)
# =============================================================================
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Verify using official source AND eth_chainId. Intentionally blank until RB-03.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_RESOLVER_REGISTRY_ADDRESS=

# =============================================================================
# RPC / Chain (B / E)
# =============================================================================
# Primary RPC endpoint (Monad testnet or local chain)
RPC_URL=
# Fallback RPC for redundancy (AT30)
RPC_FALLBACK_URL=
# Numeric chain ID — verify against the current official network and eth_chainId
CHAIN_ID=

# =============================================================================
# Database / Storage (D)
# =============================================================================
DATABASE_URL=
STORAGE_URL=
STORAGE_SERVICE_KEY=
SESSION_SECRET=
RENTBOND_DATA_DIR=.rentbond
STORAGE_BUCKET=rentbond-private
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Fixed confirmation count; B/E must validate it for the actual target network.
CHAIN_CONFIRMATIONS=1

# =============================================================================
# Auth / Passkey (C)
# =============================================================================
WEBAUTHN_RP_ID=localhost

# =============================================================================
# Deployment / Worker accounts (B / E)
# =============================================================================
# Deployer — used by B to deploy contracts (not a real private key)
DEPLOYER_ACCOUNT=
# Address allowed to mint the valueless MockUSD demo asset
MOCK_USD_MINT_OPERATOR=
# Values used by the service-profile creation/acceptance scripts
REGISTRY_ADDRESS=
MOCK_USD_ADDRESS=
PRIMARY_RESOLVER=
FALLBACK_RESOLVER=
SERVICE_TERMS_HASH=
MAX_DEPOSIT_BASE_UNITS=10000000000
MAX_LEASE_END_TIMESTAMP=
PROFILE_ACCEPT_UNTIL_TIMESTAMP=
SERVICE_PROFILE_ID=
# Worker gas — pays for Worker-triggered on-chain transactions (no lease role keys)
WORKER_GAS_ACCOUNT=
# Test gas sponsor — limited MON faucet for test participants
TEST_GAS_SPONSOR_ACCOUNT=
# Dedicated testnet sponsor key; never use a T/L/R/F key. No default.
TEST_GAS_SPONSOR_PRIVATE_KEY=
TEST_GAS_AMOUNT_WEI=10000000000000000
TEST_GAS_ACCOUNT_DAILY=3
TEST_GAS_LEASE_DAILY=8
TEST_GAS_GLOBAL_DAILY=100
TEST_GAS_COOLDOWN_SECONDS=3600
# Optional comma-separated test organizers; enables gas for their frozen,
# joined drafts before deployment, so users need not buy deployment gas.
TEST_GAS_ORGANIZERS=

# =============================================================================
# Worker (E — RB-12)
# =============================================================================
# Block number when Factory was deployed; indexer starts from here
DEPLOYMENT_BLOCK=
# Path or connection string for Worker persistence (file or DB)
PERSISTENCE_PATH=
# How many blocks to fetch per polling batch (default: 100)
WORKER_BATCH_SIZE=100
# Polling interval in milliseconds (default: 5000)
WORKER_POLL_INTERVAL_MS=5000

# =============================================================================
# Optional P1
# =============================================================================
MAIL_PROVIDER_KEY=
