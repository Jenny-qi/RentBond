# Template only. Runtime loaders are implemented in RB-02.
# Copy to .env.local and fill in real values before running any service.

# =============================================================================
# App / Web (C)
# =============================================================================
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Verify using official source AND eth_chainId. Intentionally blank until RB-03.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_RESOLVER_REGISTRY_ADDRESS=

# =============================================================================
# RPC / Chain (B / E)
# =============================================================================
# Primary RPC endpoint (Monad testnet or local chain)
RPC_URL=
# Fallback RPC for redundancy (AT30)
RPC_FALLBACK_URL=
# Numeric chain ID — verify against the current official network and eth_chainId
CHAIN_ID=
# Deployment guard: must be exactly monad-testnet for the B-owned broadcaster.
RENTBOND_DEPLOYMENT_NETWORK=
# Required only for a real broadcast; prevents an accidental preflight-to-broadcast transition.
RENTBOND_BROADCAST_CONFIRMATION=

# =============================================================================
# Database / Storage (D)
# =============================================================================
DATABASE_URL=
STORAGE_URL=
STORAGE_SERVICE_KEY=
SESSION_SECRET=

# =============================================================================
# Auth / Passkey (C)
# =============================================================================
WEBAUTHN_RP_ID=localhost

# =============================================================================
# Deployment / Worker accounts (B / E)
# =============================================================================
# Deployer — used by B to deploy contracts (not a real private key)
DEPLOYER_ACCOUNT=
# Address allowed to mint the valueless MockUSD demo asset
MOCK_USD_MINT_OPERATOR=
# Values used by the service-profile creation/acceptance scripts
REGISTRY_ADDRESS=
MOCK_USD_ADDRESS=
PRIMARY_RESOLVER=
FALLBACK_RESOLVER=
SERVICE_TERMS_HASH=
MAX_DEPOSIT_BASE_UNITS=10000000000
MAX_LEASE_END_TIMESTAMP=
PROFILE_ACCEPT_UNTIL_TIMESTAMP=
SERVICE_PROFILE_ID=

# =============================================================================
# Public deployment handoff (populate only from verified on-chain receipts)
# =============================================================================
DEPLOYED_MOCK_USD_ADDRESS=
DEPLOYED_RESOLVER_REGISTRY_ADDRESS=
DEPLOYED_DEPOSIT_ESCROW_DEPLOYER_ADDRESS=
DEPLOYED_LEASE_FACTORY_ADDRESS=
# Worker gas — pays for Worker-triggered on-chain transactions (no lease role keys)
WORKER_GAS_ACCOUNT=
# Test gas sponsor — limited MON faucet for test participants
TEST_GAS_SPONSOR_ACCOUNT=

# =============================================================================
# Worker (E — RB-12)
# =============================================================================
# LeaseFactory contract address — used to discover new escrows
FACTORY_ADDRESS=
# ResolverRegistry contract address
RESOLVER_REGISTRY_ADDRESS=
# Block number when Factory was deployed; indexer starts from here
DEPLOYMENT_BLOCK=
# Path or connection string for Worker persistence (file or DB)
PERSISTENCE_PATH=
# How many blocks to fetch per polling batch (default: 100)
WORKER_BATCH_SIZE=100
# Polling interval in milliseconds (default: 5000)
WORKER_POLL_INTERVAL_MS=5000

# =============================================================================
# Optional P1
# =============================================================================
MAIL_PROVIDER_KEY=
