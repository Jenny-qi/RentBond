# Copy to .env.staging (ignored). These are deliberately unusable placeholders.
# Keep this file operator-private; do not paste its contents or resolved Compose config.
NEXT_PUBLIC_APP_URL=https://rentbond.example.invalid
RENTBOND_SITE_HOST=rentbond.example.invalid
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_RESOLVER_REGISTRY_ADDRESS=
CHAIN_CONFIRMATIONS=
RPC_URL=
RPC_FALLBACK_URL=
DEPLOYMENT_BLOCK=
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hex passwords need no URL escaping; keep admin/app passwords distinct.
RENTBOND_DB_PASSWORD=
RENTBOND_APP_DB_PASSWORD=
SESSION_SECRET=
# Optional separate sponsor; never a Tenant/Landlord/Resolver/Fallback role key.
TEST_GAS_SPONSOR_PRIVATE_KEY=
TEST_GAS_ORGANIZERS=
